<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Magento Automation Suite"
       verbose="1"
       preserve-order="true">

    <listeners>
        <listener class-name="com.store.listeners.TestListener"/>
    </listeners>

    <test name="Register Tests">
        <classes>
            <class name="com.store.tests.RegisterTest"/>
        </classes>
    </test>

    <test name="Login Tests">
        <classes>
            <class name="com.store.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Order Tests">
        <classes>
            <class name="com.store.tests.OrderTest"/>
        </classes>
    </test>

</suite>